# Firebase Central (para gestión de tenants)
NEXT_PUBLIC_CENTRAL_FIREBASE_API_KEY=
NEXT_PUBLIC_CENTRAL_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_CENTRAL_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_CENTRAL_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_CENTRAL_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_CENTRAL_FIREBASE_APP_ID=

# Dominio principal de la plataforma
NEXT_PUBLIC_PLATFORM_DOMAIN=createam.cloud

# Admin credentials (opcional, para proteger rutas admin)
ADMIN_SECRET_KEY=your-secret-key-here

# Firebase Admin SDK (server-side only)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Firebase tenant config usado por scripts de mantenimiento (opcional)
BELLASORPRESA_FIREBASE_API_KEY=
BELLASORPRESA_FIREBASE_AUTH_DOMAIN=
BELLASORPRESA_FIREBASE_PROJECT_ID=
BELLASORPRESA_FIREBASE_STORAGE_BUCKET=
BELLASORPRESA_FIREBASE_MESSAGING_SENDER_ID=
BELLASORPRESA_FIREBASE_APP_ID=
BELLASORPRESA_FIREBASE_MEASUREMENT_ID=

# Lista de correos autorizados para panel /admin (separados por coma)
NEXT_PUBLIC_PLATFORM_ADMIN_EMAILS=

# Resend (notificaciones email)
RESEND_API_KEY=re_...
PLATFORM_ADMIN_EMAILS=

# Max requests per minute por IP para rutas admin API
ADMIN_API_RATE_LIMIT=60

# Sesion segura httpOnly para admin
SESSION_COOKIE_NAME=createam_session
SESSION_COOKIE_MAX_AGE_DAYS=5

# Integración con el ERP (CyberPOS). Las pruebas van contra api-dev; en
# producción solo cambia la URL. Sin URL o sin secreto queda apagada.
# El secreto lo genera el operador del ERP en Plataforma › Aplicaciones (app
# "catalog") y se ve una sola vez. Contrato: cyberERP/RESPUESTA_ADECUACIONES_ERP_CATALOGO.md
ERP_API_BASE_URL=https://api-dev.createam.cloud/api/v1
ERP_APP_CLIENT_ID=catalog
ERP_APP_CLIENT_SECRET=
# Secreto de la dirección de avisos (POST /api/erp/webhooks), también de Plataforma › Aplicaciones
ERP_WEBHOOK_SECRET=

# Ingreso del dueño con su usuario de CyberPOS (app "catalog"). Sin el secreto
# de sesión, la opción no aparece. Generar con: openssl rand -base64 48
ERP_SESSION_SECRET=
# Dirección de CyberPOS para el botón "Abrir CyberPOS" del panel
ERP_APP_URL=https://app-dev.createam.cloud

# Solo en desarrollo: tiendas de prueba sin Firebase. Abrir con
# http://localhost:3000/store?_domain=demo.localhost
# STOREFRONT_DEV_STORES=[{"domain":"demo.localhost","name":"Tienda demo","erp":{"partnerId":1},"storefront":{"rubro":"ferreteria-tecnologia"}}]
